# Base URL of the backend API, no trailing slash. Read at BUILD time by Vite.
#
# Local development: copy to .env.local (or keep .env.development as it is)
VITE_API_URL=http://localhost:8000
#
# Production (set in the Vercel dashboard, not in a committed file):
# VITE_API_URL=https://<hf-username>-<space-name>.hf.space
# A production build fails if this is missing or not https.
