# Backend settings. The app reads these from the environment (it does not load this file).
# Local: export them in your shell, or leave unset to use the defaults shown.
# Production: set them as Variables on the Hugging Face Space (Settings -> Variables and secrets).

# Speech model folder (model_card.json decides how it is loaded).
#   local default: ml/artifacts/ser-w2v2-v2         production: /app/ml/artifacts/ser-w2v2-v2
MODEL_DIR=/app/ml/artifacts/ser-w2v2-v2

# Folder holding questions.json for the DASS-21 questionnaire.
#   local default: ml/artifacts/survey-v1           production: /app/ml/artifacts/survey-v1
SURVEY_DIR=/app/ml/artifacts/survey-v1

# Upload and clip limits (the frontend records 5-15 s; uploads may be 1-30 s).
MAX_UPLOAD_MB=10
MIN_DURATION_S=1
MAX_DURATION_S=30

# Exact frontend origin(s), comma-separated, no trailing slash. '*' is refused.
#   local default: http://localhost:5173,http://localhost:3000
#   production: the deployed Vercel URL only
ALLOWED_ORIGINS=https://<your-project>.vercel.app

# Optional: path to an ffmpeg binary if it is not on PATH (the Docker image has it on PATH).
# FFMPEG_PATH=
